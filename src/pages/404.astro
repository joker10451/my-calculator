---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout
  title="404 — Страница не найдена | Считай.RU"
  description="Страница не найдена. Воспользуйтесь навигацией или вернитесь на главную."
  canonical="https://schitay-online.ru/404/"
>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <section class="py-20 md:py-32">
    <div class="container-main text-center max-w-2xl">
      <div class="text-8xl font-black text-gray-200 dark:text-gray-800 mb-6">404</div>
      <h1 class="font-heading text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-4">
        Страница не найдена
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 mb-10">
        Возможно, она переехала. Вот самые полезные страницы:
      </p>

      <div class="grid sm:grid-cols-2 gap-4 max-w-lg mx-auto mb-10">
        <a href="/" class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent-400 hover:shadow-md transition-all">
          <div class="font-semibold text-gray-900 dark:text-white">Главная</div>
          <div class="text-sm text-gray-500">Все калькуляторы в одном месте</div>
        </a>
        <a href="/dlya-samozanyatyh/kalkulyator-naloga/" class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent-400 hover:shadow-md transition-all">
          <div class="font-semibold text-gray-900 dark:text-white">Калькулятор налога</div>
          <div class="text-sm text-gray-500">НПД, УСН, патент — за 30 секунд</div>
        </a>
        <a href="/blog/" class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent-400 hover:shadow-md transition-all">
          <div class="font-semibold text-gray-900 dark:text-white">Блог</div>
          <div class="text-sm text-gray-500">Статьи о налогах и финансах</div>
        </a>
        <a href="/dlya-samozanyatyh/" class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-accent-400 hover:shadow-md transition-all">
          <div class="font-semibold text-gray-900 dark:text-white">Самозанятым</div>
          <div class="text-sm text-gray-500">Калькуляторы и инструкции</div>
        </a>
      </div>

      <a href="/" class="inline-flex items-center gap-2 px-8 py-3 rounded-xl bg-accent-600 text-white font-bold hover:bg-accent-700 transition-colors shadow-lg">
        На главную
      </a>
    </div>
  </section>
</Layout>
