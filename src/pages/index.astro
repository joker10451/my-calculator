---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroTeaser from '../components/HeroTeaser.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((a) => ({
    slug: a.slug,
    title: a.data.title,
    description: a.data.description,
    tags: a.data.tags,
    formattedDate: new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(a.data.pubDate),
    readingTime: Math.max(1, Math.round(a.body.split(/\s+/).length / 200)),
  }));

const catalogCards = [
  {
    title: 'Калькулятор налога НПД (4% и 6%)',
    description: 'Расчёт налога на профессиональный доход при поступлениях от физлиц и юрлиц с автоматическим применением бонуса 10 000 ₽.',
    tag: 'НПД 4% / 6%',
    tagColor: 'brand',
    href: '/dlya-samozanyatyh/kalkulyator-naloga/',
    icon: 'calculator',
  },
  {
    title: 'Вклады и налог 2026 (ст. 214.2 НК РФ)',
    description: 'Калькулятор чистого процентного дохода с учётом сложного процента, капитализации и необлагаемого лимита по ключевой ставке ЦБ РФ.',
    tag: 'ст. 214.2 НК РФ',
    tagColor: 'emerald',
    href: '/banki/kalkulyator-vkladov/',
    icon: 'bank',
  },
  {
    title: 'Сравнение НПД vs ИП (УСН 6%)',
    description: 'Анализ налоговой нагрузки самозанятого и ИП на УСН 6% с учётом фиксированных взносов 57 390 ₽ в СФР и лимитов 2026 года.',
    tag: 'УСН 6% vs НПД',
    tagColor: 'brand',
    href: '/dlya-samozanyatyh/npd-vs-ip/',
    icon: 'scale',
  },
  {
    title: 'Налоговый вычет 10 000 ₽',
    description: 'Расчёт остатка стартового налогового вычета самозанятого, снижающего ставки до 3% и 4% до полного исчерпания лимита.',
    tag: 'ст. 12 422-ФЗ',
    tagColor: 'emerald',
    href: '/dlya-samozanyatyh/vychet/',
    icon: 'gift',
  },
];

const trustPillars = [
  {
    icon: '🔒',
    title: '100% приватность',
    subtitle: 'Расчёт в браузере',
    text: 'Все математические вычисления выполняются локально на вашем устройстве. Доходы, вклады и личные данные не отправляются на сервер.',
  },
  {
    icon: '⚖️',
    title: 'Соответствие НК РФ',
    subtitle: 'Актуальные нормы 2026',
    text: 'Алгоритмы строго соблюдают требования 422-ФЗ, ст. 214.2 НК РФ, актуальные лимиты страховых взносов и нормативы ЦБ РФ.',
  },
  {
    icon: '⚡',
    title: '0 секунд ожидания',
    subtitle: 'Мгновенный результат',
    text: 'Быстрый интерактивный отклик ползунков в реальном времени. Без регистрации, очередей, авторизаций и скрытых условий.',
  },
];

const faqItems = [
  {
    question: 'Сколько налогов платит самозанятый в 2026 году?',
    answer: 'Ставка налога на профессиональный доход (НПД) составляет 4% при получении дохода от физических лиц и 6% — от юридических лиц и ИП. Лимит совокупного годового дохода составляет 2,4 млн ₽. Обязательных страховых взносов в СФР нет.',
  },
  {
    question: 'Как рассчитывается налог на вклады по правилам 2026 года?',
    answer: 'Налог 13% (или 15% при годовом совокупном доходе свыше 2,4 млн ₽) начисляется только на сумму процентных доходов, превышающую необлагаемый порог. Порог равен: 1 000 000 ₽ × максимальная ключевая ставка Банка России на 1-е число каждого месяца отчётного года.',
  },
  {
    question: 'Что выгоднее: самозанятость (НПД) или ИП на УСН 6%?',
    answer: 'При годовом доходе до 2,4 млн ₽ самозанятость выгоднее в большинстве случаев, так как освобождает от обязательных страховых взносов (в 2026 году фиксированный взнос для ИП составляет 57 390 ₽) и сложной бухгалтерской отчётности.',
  },
  {
    question: 'Как работает стартовый вычет 10 000 ₽ для самозанятых?',
    answer: 'Государство автоматически выделяет каждому новому плательщику НПД бонус в размере 10 000 ₽. Он списывается налоговой автоматически: ставка с доходов от физлиц снижается с 4% до 3% (1% скидка), а от юрлиц — с 6% до 4% (2% скидка), пока бонус не будет исчерпан.',
  },
  {
    question: 'Безопасно ли производить расчёты на сайте Считай.RU?',
    answer: 'Полностью безопасно. Вся вычислительная логика исполняется на стороне вашего браузера через JavaScript. Сервис не собирает, не хранит и не передаёт третьим лицам финансовую информацию посетителей.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Считай.RU — Финансовые калькуляторы и налоги 2026"
  description="Точный расчёт налогов самозанятых (НПД), дохода по вкладам, вычетов и страховок без регистрации и скрытых условий. Актуально на 2026 год."
  canonical="https://schitay-online.ru/"
>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO SECTION -->
  <section class="relative border-b border-slate-200/80 dark:border-slate-800/80 py-12 md:py-16 lg:py-20 fintech-grid">
    <div class="container-main">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Left Hero Column -->
        <div class="lg:col-span-7 space-y-6">
          <!-- Status Pill Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/90 dark:bg-slate-900/90 border border-slate-200/90 dark:border-slate-800/90 text-xs font-medium text-slate-700 dark:text-slate-300 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-brand-600 dark:bg-brand-400"></span>
            <span class="font-tabular">2026 • Актуальные ставки НК РФ и лимиты</span>
          </div>

          <!-- Main Title -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
            Финансовые калькуляторы <br class="hidden sm:inline" />
            <span class="text-brand-600 dark:text-brand-400">и налоги 2026</span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 leading-relaxed max-w-xl">
            Точный расчёт налогов самозанятых, дохода по вкладам, вычетов и страховок без регистрации и скрытых условий.
          </p>

          <!-- Quick Category Selector Pills -->
          <div class="pt-2">
            <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider block mb-2.5">
              Быстрый переход к расчёту
            </span>
            <div class="flex flex-wrap gap-2">
              <a
                href="/dlya-samozanyatyh/kalkulyator-naloga/"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 shadow-xs transition-colors"
              >
                <span>Налог НПД (4% / 6%)</span>
                <span class="text-slate-400">→</span>
              </a>
              <a
                href="/banki/kalkulyator-vkladov/"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 shadow-xs transition-colors"
              >
                <span>Вклады и налог</span>
                <span class="text-slate-400">→</span>
              </a>
              <a
                href="/dlya-samozanyatyh/npd-vs-ip/"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 shadow-xs transition-colors"
              >
                <span>НПД vs ИП</span>
                <span class="text-slate-400">→</span>
              </a>
              <a
                href="/dlya-samozanyatyh/vychet/"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800/90 text-slate-700 dark:text-slate-200 hover:border-brand-500/50 hover:text-brand-600 dark:hover:text-brand-400 shadow-xs transition-colors"
              >
                <span>Вычет 10 000 ₽</span>
                <span class="text-slate-400">→</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Hero Column: Interactive Teaser -->
        <div class="lg:col-span-5">
          <HeroTeaser />
        </div>
      </div>
    </div>
  </section>

  <!-- CATALOG SECTION (КАТАЛОГ ИНСТРУМЕНТОВ) -->
  <section class="py-16 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/50">
    <div class="container-main">
      <div class="max-w-2xl mb-10 md:mb-12">
        <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wider block">
          Онлайн-сервисы
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
          Каталог инструментов
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
          Проверенные математические модели и налоговые алгоритмы с учётом последних изменений законодательства.
        </p>
      </div>

      <!-- 2x2 Balanced Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 lg:gap-6">
        {catalogCards.map((card) => (
          <a
            href={card.href}
            class="group fintech-card-hover p-6 sm:p-7 flex flex-col justify-between h-full"
          >
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-brand-600 dark:text-brand-400 group-hover:bg-brand-600 group-hover:text-white transition-colors">
                  {card.icon === 'calculator' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <rect x="4" y="2" width="16" height="20" rx="2" stroke-width="2"></rect>
                      <line x1="8" y1="6" x2="16" y2="6" stroke-width="2"></line>
                      <line x1="16" y1="14" x2="16" y2="18" stroke-width="2"></line>
                      <path d="M8 10h.01M12 10h.01M16 10h.01M8 14h.01M12 14h.01M8 18h.01M12 18h.01" stroke-width="2.5" stroke-linecap="round"></path>
                    </svg>
                  )}
                  {card.icon === 'bank' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21h18M3 10h18M5 10v11M19 10v11M9 10v11M15 10v11M12 3l9 7H3l9-7z"></path>
                    </svg>
                  )}
                  {card.icon === 'scale' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"></path>
                    </svg>
                  )}
                  {card.icon === 'gift' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V4a2 2 0 114 0v4m-4-4a2 2 0 10-4 0v4m-5 4h18M4 12h16v8a2 2 0 01-2 2H6a2 2 0 01-2-2v-8z"></path>
                    </svg>
                  )}
                </div>

                <span class={`inline-flex items-center px-2.5 py-0.5 rounded-md text-[11px] font-semibold font-tabular ${
                  card.tagColor === 'emerald'
                    ? 'bg-emerald-50 dark:bg-emerald-950/70 text-emerald-700 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/80'
                    : 'bg-brand-50 dark:bg-brand-950/70 text-brand-700 dark:text-brand-300 border border-brand-200/80 dark:border-brand-800/80'
                }`}>
                  {card.tag}
                </span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors mb-2">
                {card.title}
              </h3>

              <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed mb-6">
                {card.description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs font-semibold text-brand-600 dark:text-brand-400">
              <span>Открыть калькулятор</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- TRUST PILLARS SECTION -->
  <section class="py-16 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-950">
    <div class="container-main">
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wider block">
          Стандарты сервиса
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
          Почему нам доверяют расчёты
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
          Принципы конфиденциальности и математической точности лежат в основе каждого инструмента.
        </p>
      </div>

      <!-- 3 Clean Minimal Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 lg:gap-6">
        {trustPillars.map((pillar) => (
          <div class="fintech-card p-6 sm:p-7 flex flex-col justify-between">
            <div class="space-y-3">
              <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-xl">
                {pillar.icon}
              </div>
              <div>
                <h3 class="text-base font-bold text-slate-900 dark:text-white">
                  {pillar.title}
                </h3>
                <span class="text-xs font-medium text-brand-600 dark:text-brand-400 block mt-0.5">
                  {pillar.subtitle}
                </span>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed pt-1">
                {pillar.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- LATEST ARTICLES SECTION -->
  <section class="py-16 md:py-20 border-b border-slate-200/80 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/50">
    <div class="container-main">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 md:mb-12">
        <div>
          <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wider block">
            База знаний
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
            Свежие статьи и финансовые разборы
          </h2>
        </div>
        <a
          href="/blog/"
          class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-brand-600 dark:text-brand-400 hover:text-brand-700 transition-colors"
        >
          <span>Все материалы</span>
          <span>→</span>
        </a>
      </div>

      <!-- 3 Clean Article Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
        {articles.map((article) => (
          <a
            href={`/blog/${article.slug}/`}
            class="group fintech-card-hover p-6 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                {article.tags && article.tags.length > 0 ? (
                  <span class="px-2 py-0.5 rounded-md text-[10px] font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                    {article.tags[0]}
                  </span>
                ) : (
                  <span></span>
                )}
                <span class="text-slate-400 dark:text-slate-500 text-[11px] font-tabular">
                  {article.readingTime} мин чтения
                </span>
              </div>

              <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors leading-snug mb-2">
                {article.title}
              </h3>

              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed line-clamp-3">
                {article.description}
              </p>
            </div>

            <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-400 dark:text-slate-500 font-tabular">
              <span>{article.formattedDate}</span>
              <span class="font-semibold text-brand-600 dark:text-brand-400 group-hover:translate-x-0.5 transition-transform">
                Читать →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="py-16 md:py-20 bg-white dark:bg-slate-950">
    <div class="container-main max-w-3xl">
      <div class="text-center mb-10 md:mb-12">
        <span class="text-xs font-semibold text-brand-600 dark:text-brand-400 uppercase tracking-wider block">
          Вопросы и ответы
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-1">
          Часто задаваемые вопросы
        </h2>
        <p class="text-sm text-slate-600 dark:text-slate-400 mt-2">
          Ответы на популярные вопросы о налогах, лимитах и правилах расчёта в 2026 году.
        </p>
      </div>

      <div class="space-y-3">
        {faqItems.map((item) => (
          <details class="group fintech-card p-5 open:border-brand-500/30 transition-colors">
            <summary class="flex items-center justify-between gap-4 cursor-pointer font-semibold text-sm sm:text-base text-slate-900 dark:text-white list-none">
              <span>{item.question}</span>
              <span class="w-6 h-6 rounded-md bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 shrink-0 group-open:rotate-180 transition-transform duration-200">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </summary>
            <div class="mt-3 pt-3 border-t border-slate-100 dark:border-slate-800/80 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {item.answer}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
