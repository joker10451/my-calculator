---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroTeaser from '../components/HeroTeaser.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((a) => ({
    slug: a.slug,
    title: a.data.title,
    description: a.data.description,
    tags: a.data.tags,
    formattedDate: new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(a.data.pubDate),
    readingTime: Math.max(1, Math.round(a.body.split(/\s+/).length / 200)),
  }));

const catalogCards = [
  {
    title: 'Налог самозанятого',
    description: '4% с физлиц и 6% с юрлиц, с учётом стартового вычета 10 000 ₽.',
    href: '/dlya-samozanyatyh/kalkulyator-naloga/',
  },
  {
    title: 'НПД или ИП на УСН 6%',
    description: 'Сколько вы заплатите в каждом режиме с учётом взносов ИП 57 390 ₽.',
    href: '/dlya-samozanyatyh/npd-vs-ip/',
  },
  {
    title: 'Вычет 10 000 ₽',
    description: 'Сколько стартового вычета осталось и когда ставки вернутся к 4% и 6%.',
    href: '/dlya-samozanyatyh/vychet/',
  },
  {
    title: 'Доход по вкладу',
    description: 'Проценты с капитализацией и налог сверх необлагаемого лимита (ст. 214.2 НК РФ).',
    href: '/banki/kalkulyator-vkladov/',
  },
];

const faqItems = [
  {
    question: 'Сколько налогов платит самозанятый в 2026 году?',
    answer: 'Ставка налога на профессиональный доход (НПД) составляет 4% при получении дохода от физических лиц и 6% — от юридических лиц и ИП. Лимит совокупного годового дохода составляет 2,4 млн ₽. Обязательных страховых взносов в СФР нет.',
  },
  {
    question: 'Как рассчитывается налог на вклады по правилам 2026 года?',
    answer: 'Налог 13% (или 15% при годовом совокупном доходе свыше 2,4 млн ₽) начисляется только на сумму процентных доходов, превышающую необлагаемый порог. Порог равен: 1 000 000 ₽ × максимальная ключевая ставка Банка России на 1-е число каждого месяца отчётного года.',
  },
  {
    question: 'Что выгоднее: самозанятость (НПД) или ИП на УСН 6%?',
    answer: 'При годовом доходе до 2,4 млн ₽ самозанятость выгоднее в большинстве случаев, так как освобождает от обязательных страховых взносов (в 2026 году фиксированный взнос для ИП составляет 57 390 ₽) и сложной бухгалтерской отчётности.',
  },
  {
    question: 'Как работает стартовый вычет 10 000 ₽ для самозанятых?',
    answer: 'Государство автоматически выделяет каждому новому плательщику НПД бонус в размере 10 000 ₽. Он списывается налоговой автоматически: ставка с доходов от физлиц снижается с 4% до 3% (1% скидка), а от юрлиц — с 6% до 4% (2% скидка), пока бонус не будет исчерпан.',
  },
  {
    question: 'Безопасно ли производить расчёты на сайте Считай.RU?',
    answer: 'Полностью безопасно. Вся вычислительная логика исполняется на стороне вашего браузера через JavaScript. Сервис не собирает, не хранит и не передаёт третьим лицам финансовую информацию посетителей.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Считай.RU — Финансовые калькуляторы и налоги 2026"
  description="Точный расчёт налогов самозанятых (НПД), дохода по вкладам, вычетов и страховок без регистрации и скрытых условий. Актуально на 2026 год."
  canonical="https://schitay-online.ru/"
>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="container-main pt-6 pb-12 md:pt-12 md:pb-16">
    <div class="grid gap-6 lg:grid-cols-[1fr_440px] lg:gap-12 lg:items-start">
      <div class="lg:pt-4">
        <h1 class="text-[28px] leading-tight sm:text-4xl lg:text-[44px] font-bold text-slate-900 dark:text-white">
          Калькуляторы налогов для&nbsp;самозанятых
        </h1>
        <p class="mt-3 text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-xl">
          Налог НПД, сравнение с ИП, стартовый вычет и доход по вкладу по правилам 2026 года. Без регистрации.
        </p>

        <ul class="hidden lg:grid mt-8 gap-px rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-200 dark:bg-slate-800">
          {catalogCards.map((card) => (
            <li>
              <a href={card.href} class="group flex items-center justify-between gap-4 px-5 py-4 bg-white dark:bg-slate-900 hover:bg-slate-50 dark:hover:bg-slate-800/60">
                <span>
                  <span class="block font-semibold text-slate-900 dark:text-white group-hover:text-brand-700 dark:group-hover:text-brand-300">{card.title}</span>
                  <span class="block text-sm text-slate-600 dark:text-slate-400 mt-0.5">{card.description}</span>
                </span>
                <svg class="w-5 h-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <HeroTeaser />
    </div>
  </section>

  <section class="lg:hidden container-main pb-12" aria-labelledby="calcs-heading">
    <h2 id="calcs-heading" class="text-xl font-bold text-slate-900 dark:text-white mb-3">Все калькуляторы</h2>
    <ul class="grid gap-px rounded-2xl overflow-hidden border border-slate-200 dark:border-slate-800 bg-slate-200 dark:bg-slate-800">
      {catalogCards.map((card) => (
        <li>
          <a href={card.href} class="flex items-center justify-between gap-4 px-4 py-4 min-h-12 bg-white dark:bg-slate-900 active:bg-slate-50">
            <span>
              <span class="block font-semibold text-slate-900 dark:text-white">{card.title}</span>
              <span class="block text-sm text-slate-600 dark:text-slate-400 mt-0.5">{card.description}</span>
            </span>
            <svg class="w-5 h-5 shrink-0 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="border-t border-slate-200 dark:border-slate-800 py-12 md:py-16" aria-labelledby="articles-heading">
    <div class="container-main">
      <div class="flex items-baseline justify-between gap-4 mb-6">
        <h2 id="articles-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white">Статьи</h2>
        <a href="/blog/" class="inline-flex min-h-11 items-center text-sm font-medium text-brand-700 dark:text-brand-300 hover:underline underline-offset-4">Все статьи</a>
      </div>
      <ul class="grid gap-6 md:grid-cols-3">
        {articles.map((article) => (
          <li>
            <a href={`/blog/${article.slug}/`} class="group block">
              <p class="text-sm text-slate-600 dark:text-slate-400 font-tabular">{article.formattedDate} · {article.readingTime} мин</p>
              <h3 class="mt-1 text-lg font-semibold leading-snug text-slate-900 dark:text-white group-hover:text-brand-700 dark:group-hover:text-brand-300 group-hover:underline underline-offset-4">{article.title}</h3>
              <p class="mt-2 text-sm text-slate-600 dark:text-slate-400 line-clamp-3">{article.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-slate-200 dark:border-slate-800 py-12 md:py-16" aria-labelledby="faq-heading">
    <div class="container-main max-w-3xl">
      <h2 id="faq-heading" class="text-xl sm:text-2xl font-bold text-slate-900 dark:text-white mb-4">Частые вопросы</h2>
      <div class="divide-y divide-slate-200 dark:divide-slate-800 border-y border-slate-200 dark:border-slate-800">
        {faqItems.map((item) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 min-h-12 py-3 cursor-pointer font-medium text-slate-900 dark:text-white list-none">
              <span>{item.question}</span>
              <svg class="w-5 h-5 shrink-0 text-slate-500 group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
            </summary>
            <p class="pb-4 text-slate-600 dark:text-slate-300 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
