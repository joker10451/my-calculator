---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroTeaser from '../components/HeroTeaser.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((a) => ({
    slug: a.slug,
    title: a.data.title,
    description: a.data.description,
    tags: a.data.tags,
    formattedDate: new Intl.DateTimeFormat('ru-RU', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    }).format(a.data.pubDate),
    readingTime: Math.max(1, Math.round(a.body.split(/\s+/).length / 200)),
  }));

const catalogCards = [
  {
    title: 'Налог самозанятого',
    description: '4% с физлиц и 6% с юрлиц, с учётом стартового вычета 10 000 ₽.',
    href: '/dlya-samozanyatyh/kalkulyator-naloga/',
  },
  {
    title: 'НПД или ИП на УСН 6%',
    description: 'Сколько вы заплатите в каждом режиме с учётом взносов ИП 57 390 ₽.',
    href: '/dlya-samozanyatyh/npd-vs-ip/',
  },
  {
    title: 'Вычет 10 000 ₽',
    description: 'Сколько стартового вычета осталось и когда ставки вернутся к 4% и 6%.',
    href: '/dlya-samozanyatyh/vychet/',
  },
  {
    title: 'Доход по вкладу',
    description: 'Проценты с капитализацией и налог сверх необлагаемого лимита (ст. 214.2 НК РФ).',
    href: '/banki/kalkulyator-vkladov/',
  },
];

const faqItems = [
  {
    question: 'Сколько налогов платит самозанятый в 2026 году?',
    answer: 'Ставка налога на профессиональный доход (НПД) составляет 4% при получении дохода от физических лиц и 6% — от юридических лиц и ИП. Лимит совокупного годового дохода составляет 2,4 млн ₽. Обязательных страховых взносов в СФР нет.',
  },
  {
    question: 'Как рассчитывается налог на вклады по правилам 2026 года?',
    answer: 'Налог 13% (или 15% при годовом совокупном доходе свыше 2,4 млн ₽) начисляется только на сумму процентных доходов, превышающую необлагаемый порог. Порог равен: 1 000 000 ₽ × максимальная ключевая ставка Банка России на 1-е число каждого месяца отчётного года.',
  },
  {
    question: 'Что выгоднее: самозанятость (НПД) или ИП на УСН 6%?',
    answer: 'При годовом доходе до 2,4 млн ₽ самозанятость выгоднее в большинстве случаев, так как освобождает от обязательных страховых взносов (в 2026 году фиксированный взнос для ИП составляет 57 390 ₽) и сложной бухгалтерской отчётности.',
  },
  {
    question: 'Как работает стартовый вычет 10 000 ₽ для самозанятых?',
    answer: 'Государство автоматически выделяет каждому новому плательщику НПД бонус в размере 10 000 ₽. Он списывается налоговой автоматически: ставка с доходов от физлиц снижается с 4% до 3% (1% скидка), а от юрлиц — с 6% до 4% (2% скидка), пока бонус не будет исчерпан.',
  },
  {
    question: 'Безопасно ли производить расчёты на сайте Считай.RU?',
    answer: 'Полностью безопасно. Вся вычислительная логика исполняется на стороне вашего браузера через JavaScript. Сервис не собирает, не хранит и не передаёт третьим лицам финансовую информацию посетителей.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Считай.RU — Финансовые калькуляторы и налоги 2026"
  description="Точный расчёт налогов самозанятых (НПД), дохода по вкладам, вычетов и страховок без регистрации и скрытых условий. Актуально на 2026 год."
  canonical="https://schitay-online.ru/"
>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <section class="container-main pt-8 md:pt-14">
    <h1 class="max-w-4xl text-[30px] leading-[1.1] sm:text-5xl lg:text-[60px] text-ink-900 dark:text-ink-50">
      Калькуляторы налогов для&nbsp;самозанятых
    </h1>
    <p class="mt-4 max-w-2xl text-[17px] sm:text-xl leading-relaxed text-ink-600 dark:text-ink-300">
      Налог НПД, сравнение с ИП, стартовый вычет и доход по вкладу по правилам 2026 года. Без регистрации.
    </p>
  </section>

  <section class="container-main pt-8 pb-14 md:pt-12 md:pb-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_420px] lg:gap-16">
      <div class="order-last lg:order-none">
        <h2 id="calcs-heading" class="label font-sans tracking-normal mb-3">Все калькуляторы</h2>
        <ul class="border-t-2 border-ink-900 dark:border-ink-200 divide-y divide-ink-200 dark:divide-ink-800 border-b" aria-labelledby="calcs-heading">
          {catalogCards.map((card) => (
            <li>
              <a href={card.href} class="group grid grid-cols-[1fr_auto] items-baseline gap-x-6 py-5">
                <span class="font-serif text-[22px] sm:text-2xl font-semibold leading-snug text-ink-900 dark:text-ink-50 group-hover:underline underline-offset-4 decoration-1">{card.title}</span>
                <span class="text-brand-600 dark:text-brand-300 text-xl" aria-hidden="true">→</span>
                <span class="mt-1 text-[15px] text-ink-600 dark:text-ink-400">{card.description}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="order-first lg:order-none">
        <HeroTeaser />
      </div>
    </div>
  </section>

  <section class="border-t border-ink-900 dark:border-ink-700 py-12 md:py-16" aria-labelledby="articles-heading">
    <div class="container-main">
      <div class="flex items-baseline justify-between gap-4 mb-8">
        <h2 id="articles-heading" class="text-[28px] sm:text-[32px] text-ink-900 dark:text-ink-50">Статьи</h2>
        <a href="/blog/" class="inline-flex min-h-11 items-center text-[15px] text-ink-800 dark:text-ink-200 underline underline-offset-4 decoration-1 hover:decoration-2">Все статьи</a>
      </div>
      <ul class="grid gap-8 md:grid-cols-3 md:gap-0 md:divide-x divide-ink-200 dark:divide-ink-800">
        {articles.map((article) => (
          <li class="md:px-6 md:first:pl-0 md:last:pr-0">
            <a href={`/blog/${article.slug}/`} class="group block">
              <p class="label tabular-nums">{article.formattedDate} · {article.readingTime} мин</p>
              <h3 class="mt-2 text-[22px] leading-snug text-ink-900 dark:text-ink-50 group-hover:underline underline-offset-4 decoration-1">{article.title}</h3>
              <p class="mt-3 text-[15px] text-ink-600 dark:text-ink-400 line-clamp-3">{article.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-ink-900 dark:border-ink-700 py-12 md:py-16" aria-labelledby="faq-heading">
    <div class="container-main grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <h2 id="faq-heading" class="text-[28px] sm:text-[32px] text-ink-900 dark:text-ink-50">Частые вопросы</h2>
      <div class="divide-y divide-ink-200 dark:divide-ink-800 border-y border-ink-200 dark:border-ink-800">
        {faqItems.map((item) => (
          <details class="group">
            <summary class="flex items-center justify-between gap-4 min-h-14 py-4 cursor-pointer text-[17px] font-medium text-ink-900 dark:text-ink-50 list-none">
              <span>{item.question}</span>
              <span class="shrink-0 text-xl leading-none text-ink-500 group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
            </summary>
            <p class="pb-5 max-w-2xl text-ink-700 dark:text-ink-300 leading-relaxed">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }
</style>
