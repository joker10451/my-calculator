---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const title = 'Подбор банковских продуктов 2026 — карты, вклады, кредиты | Считай.RU';
const desc = 'Сравните кредитные карты, вклады и кредиты от 30+ банков. Подбор по вашим параметрам. Бесплатно, без регистрации.';
const canonical = 'https://schitay-online.ru/banki/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://schitay-online.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Банки и карты', item: canonical },
  ],
};

const widgetSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Подбор банковских продуктов',
  description: 'Сравнение кредитных карт, вкладов и кредитов от 30+ банков',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'RUB' },
  provider: { '@type': 'Organization', name: 'Pampadu', url: 'https://pampadu.ru' },
};

const faqItems = [
  {
    question: 'Это бесплатно?',
    answer: 'Да, полностью. Вы ничего не платите за подбор — сервис бесплатный. Банки платят комиссию Pampadu за привлечённых клиентов, на ваших условиях это не отражается.',
  },
  {
    question: 'Мои данные уйдут в банк?',
    answer: 'Только если вы сами решите оформить продукт и заполните анкету. Мы не передаём данные без вашего действия.',
  },
  {
    question: 'Почему ставки в разных банках отличаются?',
    answer: 'Каждый банк оценивает риски по-своему: кредитная история, доход, регион, возраст. Даже на один и тот же продукт ставка может различаться в 2–3 раза. Витрина показывает все предложения — выбирайте лучшее.',
  },
  {
    question: 'Можно ли оформить онлайн?',
    answer: 'Да, большинство продуктов оформляется полностью онлайн: заполнить заявку, дождаться одобрения и подписать договор электронной подписью. В офис ехать не нужно.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

const products = [
  { icon: '💰', name: 'Вклады и счета', desc: 'Ставки до 22% годовых, расчёт налога 2026', href: '/banki/kalkulyator-vkladov/' },
  { icon: '💳', name: 'Кредитные карты', desc: 'Кэшбэк до 30%, льготный период 120+ дней', href: '#ppdwiBanki' },
  { icon: '🏦', name: 'Кредиты наличными', desc: 'От 4,9%, одобрение за 5 минут', href: '#ppdwiBanki' },
  { icon: '💼', name: 'РКО для бизнеса', desc: '0 ₽/мес, бесплатные переводы', href: '#ppdwiBanki' },
];
---

<Layout {title} description={desc} {canonical} type="website">
  <Fragment slot="header"><Header /></Fragment>

  <!-- Breadcrumbs -->
  <nav class="container-main pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item" class="hover:text-accent-600 transition-colors"><span itemprop="name">Главная</span></a>
        <meta itemprop="position" content="1" />
        <span class="mx-1">/</span>
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="text-gray-800 dark:text-gray-200 font-medium">
        <span itemprop="name">Банки и карты</span>
        <meta itemprop="position" content="2" />
      </li>
    </ol>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(widgetSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- HERO -->
  <section class="container-main py-8 md:py-12">
    <div class="max-w-3xl">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 dark:text-white leading-tight mb-4">
        Подбор банковских продуктов — сравните и выберите
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        Кредитные карты, вклады, кредиты наличными, РКО. 30+ банков, честное сравнение. Бесплатно.
      </p>
    </div>

    <!-- PROMO BANNER / CARD -->
    <div class="mt-8 p-6 md:p-8 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-700 to-slate-900 text-white shadow-xl flex flex-col md:flex-row md:items-center md:justify-between gap-6 relative overflow-hidden">
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 rounded-full -translate-y-32 translate-x-32 pointer-events-none" />
      <div class="relative space-y-2">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 text-emerald-100 text-xs font-bold">
          <span>🔥</span> Калькулятор доходности и налога по вкладам 2026
        </div>
        <h2 class="text-xl md:text-2xl font-black font-heading leading-snug">
          Рассчитайте сложный процент, капитализацию и налог по ст. 214.2 НК РФ
        </h2>
        <p class="text-sm text-emerald-100/90 max-w-xl">
          Точный расчёт чистой доходности с учётом необлагаемого лимита 1 млн ₽ × ключевая ставка ЦБ.
        </p>
      </div>
      <a
        href="/banki/kalkulyator-vkladov/"
        class="relative inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white text-slate-900 font-bold text-sm hover:bg-emerald-50 transition-all shadow-lg shrink-0"
      >
        Открыть калькулятор →
      </a>
    </div>
  </section>

  <!-- PAMPADU WIDGET -->
  <section class="container-main pb-8">
    <!-- Category Jump Pills -->
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Быстрый подбор:</span>
      <a
        href="/banki/kalkulyator-vkladov/"
        class="px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-700/60 text-emerald-700 dark:text-emerald-300 text-xs font-bold hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors flex items-center gap-1.5"
      >
        <span>🔥</span> Вклады до 22%
      </a>
      <a
        href="#ppdwiBanki"
        class="px-3.5 py-1.5 rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold hover:border-accent-400 hover:text-accent-600 transition-colors flex items-center gap-1.5"
      >
        <span>💳</span> Карты с кэшбэком
      </a>
      <a
        href="#ppdwiBanki"
        class="px-3.5 py-1.5 rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold hover:border-accent-400 hover:text-accent-600 transition-colors flex items-center gap-1.5"
      >
        <span>⏳</span> Кредитные карты
      </a>
      <a
        href="#ppdwiBanki"
        class="px-3.5 py-1.5 rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-xs font-bold hover:border-accent-400 hover:text-accent-600 transition-colors flex items-center gap-1.5"
      >
        <span>💼</span> РКО для бизнеса
      </a>
    </div>

    <div class="pampadu-widget pampadu-widget--banki">
      <iframe
        src="https://ppdu.ru/41ef6068-a4eb-4179-a855-6c0270f8acf0"
        style="width: 100%; border: none; height: 900px; min-width: 320px; overflow: auto; border-radius: 16px;"
        id="ppdwiBanki"
        scrolling="yes"
        title="Подбор банковских продуктов — карты, вклады, кредиты"
        loading="lazy"
      ></iframe>
    </div>

    <!-- Disclosure -->
    <p class="mt-3 text-xs text-gray-400 dark:text-gray-500 leading-relaxed">
      Подбор продуктов через платформу Pampadu (ООО «Страховые Партнёры», ИНН 9729069737). Партнёрская ссылка. Мы получаем комиссию от банков, для вас условия не меняются.
    </p>
  </section>

  <!-- Что можно подобрать -->
  <section class="container-main pb-12">
    <h2 class="font-heading text-2xl font-black text-gray-900 dark:text-white mb-6">Что можно подобрать</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {products.map((p) => (
        <a href={p.href} class="group p-5 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 hover:shadow-md hover:border-accent-300 dark:hover:border-accent-700 transition-all block">
          <div class="text-2xl mb-3 group-hover:scale-110 transition-transform" aria-hidden="true">{p.icon}</div>
          <h3 class="font-bold text-gray-900 dark:text-white mb-1 group-hover:text-accent-600 transition-colors">{p.name}</h3>
          <p class="text-sm text-gray-500 dark:text-gray-400">{p.desc}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Как выбрать -->
  <section class="container-main pb-12">
    <h2 class="font-heading text-2xl font-black text-gray-900 dark:text-white mb-2">Как выбрать</h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">Три совета, чтобы не переплатить:</p>
    <div class="grid md:grid-cols-3 gap-5">
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
        <div class="w-10 h-10 rounded-xl bg-accent-50 dark:bg-accent-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 dark:text-white mb-1 text-sm">Кредитная карта</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400">Смотрите на льготный период и кэшбэк в ваших категориях. Грейс 120+ дней даёт 4 месяца без процентов.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
        <div class="w-10 h-10 rounded-xl bg-accent-50 dark:bg-accent-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 dark:text-white mb-1 text-sm">Вклад</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400">Сравнивайте эффективную ставку (с учётом капитализации), а не номинальную. Капитализация может дать +0.5–1% к доходу.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
        <div class="w-10 h-10 rounded-xl bg-accent-50 dark:bg-accent-900/30 flex items-center justify-center mb-4">
          <svg class="w-5 h-5 text-accent-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        </div>
        <h3 class="font-bold text-gray-900 dark:text-white mb-1 text-sm">Кредит</h3>
        <p class="text-xs text-gray-500 dark:text-gray-400">Смотрите на ПСК (полная стоимость кредита), а не рекламную ставку. ПСК включает все комиссии и страховки.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-main pb-12" id="faq">
    <h2 class="font-heading text-2xl font-black text-gray-900 dark:text-white mb-6">Часто задаваемые вопросы</h2>
    <div class="max-w-3xl space-y-2">
      {faqItems.map((item) => (
        <details class="group rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 overflow-hidden">
          <summary class="flex items-center justify-between gap-3 px-5 py-4 cursor-pointer font-bold text-gray-900 dark:text-white hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors [&::-webkit-details-marker]:hidden">
            <span>{item.question}</span>
            <svg class="w-5 h-5 text-gray-400 shrink-0 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <div class="px-5 pb-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed max-h-0 overflow-hidden opacity-0 transition-all duration-300 group-open:max-h-[500px] group-open:opacity-100">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-main pb-16">
    <div class="p-7 md:p-9 rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 dark:from-gray-800 dark:to-gray-900 text-white text-center">
      <h3 class="font-heading text-xl font-bold mb-2">Подберите продукт прямо сейчас</h3>
      <p class="text-gray-300 text-sm mb-6">30+ банков, честное сравнение, бесплатно</p>
      <a href="#ppdwiBanki" class="inline-block px-6 py-3 rounded-xl bg-accent-600 text-white font-bold hover:bg-accent-700 transition-colors shadow-lg">↑ Подобрать продукт</a>
    </div>
  </section>
</Layout>

<style>
  .pampadu-widget--banki {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.06);
  }
  .pampadu-widget--banki iframe {
    width: 100%;
    height: 900px;
    border: none;
    border-radius: 16px;
  }
  @media (max-width: 768px) {
    .pampadu-widget--banki iframe {
      height: 1000px;
    }
  }
</style>

<script>
  (function() {
    var widget = document.querySelector('.pampadu-widget--banki');
    if (widget && typeof window.ym !== 'undefined') {
      var observer = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            ym(106217699, 'reachGoal', 'banking_widget_view');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      observer.observe(widget);
    }

    if (widget && typeof gtag !== 'undefined') {
      var gaObserver = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            gtag('event', 'widget_impression', {
              widget_type: 'banking',
              partner: 'pampadu'
            });
            gaObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      gaObserver.observe(widget);
    }
  })();
</script>
