---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const title = 'Калькуляторы для семьи — ипотека, маткапитал, алименты | Считай.RU';
const desc = 'Семейные финансы под контролем: ипотека с маткапиталом, расчёт алиментов, пособия на детей. Скоро на Считай.RU.';
const canonical = 'https://schitay-online.ru/dlya-semi/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://schitay-online.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Семье', item: canonical },
  ],
};
---

<Layout {title} description={desc} {canonical} type="website">
  <Fragment slot="header"><Header /></Fragment>

  <nav class="container-main pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item" class="hover:text-accent-600 transition-colors"><span itemprop="name">Главная</span></a>
        <meta itemprop="position" content="1" />
        <span class="mx-1">/</span>
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="text-gray-800 dark:text-gray-200 font-medium">
        <span itemprop="name">Семье</span>
        <meta itemprop="position" content="2" />
      </li>
    </ol>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container-main py-8 md:py-12">
    <div class="max-w-3xl">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl font-black text-gray-900 dark:text-white leading-tight mb-4">
        Калькуляторы для семьи: ипотека, маткапитал, алименты
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
        Семейные финансы — непростая тема. Мы готовим калькуляторы, которые помогут вам
        рассчитать ипотеку с маткапиталом, алименты и пособия на детей. Следите за обновлениями.
      </p>
    </div>
  </div>

  <section class="container-main pb-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 opacity-60">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          </div>
          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400">Скоро</span>
        </div>
        <h2 class="font-heading font-bold text-lg text-gray-900 dark:text-white mb-1">Ипотека с маткапиталом</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Рассчитайте ежемесячный платёж с учётом маткапитала.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 opacity-60">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400">Скоро</span>
        </div>
        <h2 class="font-heading font-bold text-lg text-gray-900 dark:text-white mb-1">Калькулятор алиментов</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">Сколько алиментов положено — на 1, 2 и 3 детей.</p>
      </div>
      <div class="p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 opacity-60">
        <div class="flex items-start justify-between mb-4">
          <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center">
            <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <span class="px-2.5 py-1 text-xs font-bold rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400">Скоро</span>
        </div>
        <h2 class="font-heading font-bold text-lg text-gray-900 dark:text-white mb-1">Маткапитал 2026</h2>
        <p class="text-sm text-gray-500 dark:text-gray-400">675 тыс. ₽ — на что потратить и как получить.</p>
      </div>
    </div>
  </section>

  <section class="container-main pb-16">
    <div class="p-7 md:p-9 rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 dark:from-gray-800 dark:to-gray-900 text-white text-center">
      <h3 class="font-heading text-xl font-bold mb-2">Подпишись на Telegram — узнаешь первым</h3>
      <p class="text-gray-300 text-sm mb-6">Калькуляторы для семьи появятся в ближайшее время</p>
      <a href="#" class="inline-block px-6 py-3 rounded-xl bg-accent-600 text-white font-bold hover:bg-accent-700 transition-colors shadow-lg">Подписаться</a>
    </div>
  </section>
</Layout>
