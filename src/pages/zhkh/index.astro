---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const title = 'ЖКХ | Считай.RU';
const desc = 'Калькуляторов по коммунальным платежам на Считай.RU пока нет.';
const canonical = 'https://schitay-online.ru/zhkh/';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://schitay-online.ru/' },
    { '@type': 'ListItem', position: 2, name: 'ЖКХ', item: canonical },
  ],
};
---

<Layout {title} description={desc} {canonical} type="website" noindex>
  <Fragment slot="header"><Header /></Fragment>

  <nav class="container-main pt-6 pb-2" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400" itemscope itemtype="https://schema.org/BreadcrumbList">
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" itemprop="item" class="hover:text-accent-600 transition-colors"><span itemprop="name">Главная</span></a>
        <meta itemprop="position" content="1" />
        <span class="mx-1">/</span>
      </li>
      <li itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" class="text-gray-800 dark:text-gray-200 font-medium">
        <span itemprop="name">ЖКХ</span>
        <meta itemprop="position" content="2" />
      </li>
    </ol>
  </nav>

  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="container-main py-8 md:py-12">
    <div class="max-w-2xl">
      <h1 class="text-[28px] leading-tight sm:text-4xl lg:text-[40px] text-ink-900 dark:text-ink-50 mb-4">
        Коммунальные платежи
      </h1>
      <p class="text-lg text-ink-700 dark:text-ink-300 leading-relaxed">
        Калькуляторов по ЖКХ на сайте пока нет. Сейчас можно посчитать налоги самозанятого и доход по вкладу.
      </p>
      <ul class="mt-8 border-t-2 border-ink-900 dark:border-ink-200 divide-y divide-ink-200 dark:divide-ink-800 border-b">
        <li><a href="/dlya-samozanyatyh/kalkulyator-naloga/" class="flex items-center justify-between min-h-14 font-serif text-xl text-ink-900 dark:text-ink-50 hover:underline underline-offset-4 decoration-1">Налог самозанятого <span class="text-brand-600 dark:text-brand-300" aria-hidden="true">→</span></a></li>
        <li><a href="/dlya-samozanyatyh/npd-vs-ip/" class="flex items-center justify-between min-h-14 font-serif text-xl text-ink-900 dark:text-ink-50 hover:underline underline-offset-4 decoration-1">НПД или ИП <span class="text-brand-600 dark:text-brand-300" aria-hidden="true">→</span></a></li>
        <li><a href="/banki/kalkulyator-vkladov/" class="flex items-center justify-between min-h-14 font-serif text-xl text-ink-900 dark:text-ink-50 hover:underline underline-offset-4 decoration-1">Доход по вкладу <span class="text-brand-600 dark:text-brand-300" aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </div>
</Layout>
