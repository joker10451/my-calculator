---
// Партнёрский блок в редакционном стиле: линии вместо карточек, без иконок и эмодзи.
interface Feature {
  title: string;
  desc: string;
  tag: string;
}

interface Props {
  ariaLabel: string;
  eyebrow: string;
  title: string;
  subtitle: string;
  features: Feature[];
  partner: string;
  primary: { url: string; label: string; offer: string };
  secondary: { url: string; label: string; offer: string };
  disclosure: string;
  className?: string;
}

const { ariaLabel, eyebrow, title, subtitle, features, partner, primary, secondary, disclosure, className = '' } = Astro.props;
---

<section class={`container-main pb-12 ${className}`} aria-label={ariaLabel}>
  <div class="border-t-2 border-ink-900 dark:border-ink-200 pt-6 md:pt-8">
    <p class="label uppercase tracking-wider">{eyebrow}</p>

    <div class="max-w-3xl mt-2 mb-8">
      <h2 class="font-serif text-2xl md:text-3xl lg:text-4xl font-semibold text-ink-900 dark:text-ink-50 leading-tight [text-wrap:balance]">
        {title}
      </h2>
      <p class="mt-3 text-sm md:text-base text-ink-700 dark:text-ink-300 leading-relaxed">
        {subtitle}
      </p>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-3 border-t border-ink-200 dark:border-ink-800 mb-8">
      {features.map((item, i) => (
        <li class={`py-5 md:px-5 border-b md:border-b-0 border-ink-200 dark:border-ink-800 ${i > 0 ? 'md:border-l' : 'md:pl-0'}`}>
          <p class="label font-tabular">{String(i + 1).padStart(2, '0')} · {item.tag}</p>
          <h3 class="mt-2 font-serif text-lg font-semibold text-ink-900 dark:text-ink-50">{item.title}</h3>
          <p class="mt-1 text-sm text-ink-700 dark:text-ink-300 leading-relaxed">{item.desc}</p>
        </li>
      ))}
    </ol>

    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a
          href={primary.url}
          target="_blank"
          rel="sponsored nofollow noopener"
          data-affiliate="true"
          data-partner={partner}
          data-offer={primary.offer}
          class="min-h-12 py-3 px-6 bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm text-center flex items-center justify-center"
        >
          {primary.label}
        </a>
        <a
          href={secondary.url}
          target="_blank"
          rel="sponsored nofollow noopener"
          data-affiliate="true"
          data-partner={partner}
          data-offer={secondary.offer}
          class="min-h-12 py-3 px-5 text-ink-900 dark:text-ink-50 font-semibold text-sm text-center flex items-center justify-center underline underline-offset-4 decoration-ink-300 hover:decoration-ink-900"
        >
          {secondary.label}
        </a>
      </div>
      <p class="text-[12px] text-ink-600 dark:text-ink-400 lg:text-right">{disclosure}</p>
    </div>
  </div>
</section>
