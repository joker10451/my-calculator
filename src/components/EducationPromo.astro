---
import PartnerPromo from './PartnerPromo.astro';

interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Прокачайте навыки: английский для фрилансеров и специалистов',
  subtitle = 'Повышайте чек на услугах и работайте с международными клиентами. Пройдите бесплатный тест уровня за 15 минут от Skyeng.',
  className = '',
} = Astro.props;
---

<PartnerPromo
  ariaLabel="Skyeng: английский для фрилансеров и специалистов"
  eyebrow="Обучение и карьера · Skyeng"
  title={title}
  subtitle={subtitle}
  className={className}
  partner="Skyeng"
  features={[
    { tag: '15 минут', title: 'Бесплатный онлайн-тест уровня', desc: '15 минут с персональным разбором и подарком' },
    { tag: 'Для дохода', title: 'Деловой английский', desc: 'Презентации, переписка, переговоры и прохождение собеседований' },
    { tag: 'Онлайн', title: 'Индивидуальный график', desc: 'Гибкое расписание и интерактивная платформа' },
  ]}
  primary={{
    url: 'https://trk.ppdu.ru/click/MqxKoV4h?erid=2SDnjd453eC&dl=https%3A%2F%2Fmagazine.skyeng.ru%2Fenglishlevel-adult',
    label: 'Пройти тест уровня бесплатно',
    offer: 'Бесплатный тест уровня',
  }}
  secondary={{
    url: 'https://trk.ppdu.ru/click/MqxKoV4h?erid=2SDnjd453eC',
    label: 'Все программы обучения',
    offer: 'Все программы обучения',
  }}
  disclosure="Реклама. ЧОУ ДПО «Скаенг», ИНН 9709022748, erid: 2SDnjd453eC"
/>
