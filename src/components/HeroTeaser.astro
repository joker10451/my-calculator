---
// Pure HTML/CSS/JS teaser — zero framework overhead.
// Simplified NPD vs USN comparison for the hero section.
---

<div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 shadow-card">
  <h2 class="text-lg font-semibold text-slate-900 dark:text-white">
    Сколько платить: самозанятость или ИП
  </h2>
  <p class="text-sm text-slate-600 dark:text-slate-400 mt-0.5">НПД 4% против ИП на УСН 6% со взносами</p>

  <div class="mt-5">
    <div class="flex items-baseline justify-between gap-3">
      <label class="text-sm font-medium text-slate-700 dark:text-slate-300" for="hero-income">Доход в месяц</label>
      <output for="hero-income" class="text-2xl font-bold font-tabular text-slate-900 dark:text-white" id="hero-income-value">
        100 000 ₽
      </output>
    </div>
    <input
      type="range"
      id="hero-income"
      min="10000"
      max="500000"
      step="5000"
      value="100000"
      class="mt-3 w-full h-6 cursor-pointer"
    />
    <div class="flex justify-between text-xs text-slate-500 dark:text-slate-400 mt-1 font-tabular" aria-hidden="true">
      <span>10 000 ₽</span>
      <span>500 000 ₽</span>
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-3">
    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3.5">
      <dt class="text-sm text-slate-600 dark:text-slate-300">Самозанятый, 4%</dt>
      <dd class="mt-1 text-xl font-bold font-tabular text-slate-900 dark:text-white" id="hero-npd-amount">4 000 ₽</dd>
      <dd class="text-xs text-slate-500 dark:text-slate-400">в месяц, взносов нет</dd>
      <dd class="mt-2 h-1.5 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden" aria-hidden="true">
        <div class="h-full rounded-full bg-emerald-600" id="hero-npd-bar" style="width: 67%"></div>
      </dd>
    </div>
    <div class="rounded-xl bg-slate-50 dark:bg-slate-800/60 p-3.5">
      <dt class="text-sm text-slate-600 dark:text-slate-300">ИП, УСН 6%</dt>
      <dd class="mt-1 text-xl font-bold font-tabular text-slate-900 dark:text-white" id="hero-usn-amount">6 000 ₽</dd>
      <dd class="text-xs text-slate-500 dark:text-slate-400 font-tabular">в месяц с взносами 57 390 ₽/год</dd>
      <dd class="mt-2 h-1.5 rounded-full bg-slate-200 dark:bg-slate-700 overflow-hidden" aria-hidden="true">
        <div class="h-full rounded-full bg-slate-500" id="hero-usn-bar" style="width: 100%"></div>
      </dd>
    </div>
  </dl>

  <p class="mt-4 text-sm font-medium text-emerald-800 dark:text-emerald-300" id="hero-verdict" aria-live="polite">
    Самозанятость экономит 2 000 ₽ в месяц
  </p>

  <a
    href="/dlya-samozanyatyh/npd-vs-ip/"
    class="mt-4 flex items-center justify-center min-h-12 px-4 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold"
  >
    Подробное сравнение НПД и ИП
  </a>
</div>

<script>
(function() {
  const slider = document.getElementById('hero-income') as HTMLInputElement | null;
  const valueEl = document.getElementById('hero-income-value');
  const npdEl = document.getElementById('hero-npd-amount');
  const usnEl = document.getElementById('hero-usn-amount');
  const npdBar = document.getElementById('hero-npd-bar');
  const usnBar = document.getElementById('hero-usn-bar');
  const verdictEl = document.getElementById('hero-verdict');

  if (!slider) return;

  function calcBurden(income: number) {
    const npd = income * 0.04;
    const annual = income * 12;
    const mf = 57390 / 12;
    const m1p = Math.max(0, (annual - 300000) * 0.01) / 12;
    const contribs = mf + m1p;
    const baseTax = income * 0.06;
    const ded = Math.min(contribs, baseTax);
    const taxPayable = Math.max(0, baseTax - ded);
    const usn = taxPayable + contribs;
    return { npd, usn };
  }

  function fmt(n: number) {
    return Math.round(n).toLocaleString('ru-RU');
  }

  function update(income: number) {
    const r = calcBurden(income);
    const maxVal = Math.max(r.npd, r.usn, 1);
    const npdPct = (r.npd / maxVal) * 100;
    const usnPct = (r.usn / maxVal) * 100;

    if (npdEl) npdEl.textContent = fmt(r.npd) + ' ₽';
    if (usnEl) usnEl.textContent = fmt(r.usn) + ' ₽';
    if (npdBar) npdBar.style.width = Math.max(npdPct, 6) + '%';
    if (usnBar) usnBar.style.width = Math.max(usnPct, 6) + '%';

    const diff = Math.abs(r.npd - r.usn);
    const threshold = Math.max(r.npd, r.usn) * 0.02;
    let text = '';
    if (diff <= threshold) {
      text = 'Нагрузка в обоих режимах почти одинаковая';
    } else if (r.npd < r.usn) {
      text = 'Самозанятость экономит ' + fmt(r.usn - r.npd) + ' ₽ в месяц';
    } else {
      text = 'ИП на УСН 6% выгоднее на ' + fmt(r.npd - r.usn) + ' ₽ в месяц';
    }
    if (verdictEl) {
      verdictEl.textContent = text;
      verdictEl.className = 'mt-4 text-sm font-medium ' + (r.npd <= r.usn ? 'text-emerald-800 dark:text-emerald-300' : 'text-slate-800 dark:text-slate-200');
    }
  }

  slider.addEventListener('input', function() {
    const val = parseInt((this as HTMLInputElement).value, 10);
    if (valueEl) valueEl.textContent = fmt(val) + ' ₽';
    slider.setAttribute('aria-valuetext', fmt(val) + ' рублей');
    update(val);
  });

  update(parseInt(slider.value, 10));
})();
</script>
