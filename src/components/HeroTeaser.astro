---
// Pure HTML/CSS/JS teaser — zero framework overhead.
// Simplified NPD vs USN comparison for the hero section.
---

<div class="border-t-2 border-ink-900 dark:border-ink-200 pt-4">
  <h2 class="text-[22px] leading-snug text-ink-900 dark:text-ink-50">
    Сколько платить: самозанятость или ИП
  </h2>
  <p class="label mt-1">НПД 4% против ИП на УСН 6% со взносами</p>

  <div class="mt-6">
    <div class="flex items-baseline justify-between gap-3">
      <label class="label" for="hero-income">Доход в месяц</label>
      <output for="hero-income" class="font-serif text-2xl font-semibold tabular-nums text-ink-900 dark:text-ink-50" id="hero-income-value">
        100 000 ₽
      </output>
    </div>
    <input
      type="range"
      id="hero-income"
      min="10000"
      max="500000"
      step="5000"
      value="100000"
      class="mt-3 w-full h-6 cursor-pointer"
    />
    <div class="flex justify-between text-xs text-ink-500 dark:text-ink-400 mt-1 tabular-nums" aria-hidden="true">
      <span>10 000 ₽</span>
      <span>500 000 ₽</span>
    </div>
  </div>

  <dl class="mt-6 grid grid-cols-2 border-y border-ink-200 dark:border-ink-800 divide-x divide-ink-200 dark:divide-ink-800">
    <div class="py-4 pr-4">
      <dt class="label">Самозанятый, 4%</dt>
      <dd class="mt-2 font-serif text-[32px] sm:text-[40px] leading-none font-semibold tabular-nums tracking-tight text-ink-900 dark:text-ink-50" id="hero-npd-amount">4 000 ₽</dd>
      <dd class="mt-2 text-xs text-ink-500 dark:text-ink-400">в месяц, взносов нет</dd>
      <dd class="mt-3 h-0.5 bg-ink-200 dark:bg-ink-800" aria-hidden="true">
        <div class="h-full bg-brand-600 dark:bg-brand-300" id="hero-npd-bar" style="width: 67%"></div>
      </dd>
    </div>
    <div class="py-4 pl-4">
      <dt class="label">ИП, УСН 6%</dt>
      <dd class="mt-2 font-serif text-[32px] sm:text-[40px] leading-none font-semibold tabular-nums tracking-tight text-ink-900 dark:text-ink-50" id="hero-usn-amount">6 000 ₽</dd>
      <dd class="mt-2 text-xs text-ink-500 dark:text-ink-400 tabular-nums">в месяц с взносами 57 390 ₽/год</dd>
      <dd class="mt-3 h-0.5 bg-ink-200 dark:bg-ink-800" aria-hidden="true">
        <div class="h-full bg-ink-500" id="hero-usn-bar" style="width: 100%"></div>
      </dd>
    </div>
  </dl>

  <p class="mt-4 text-[15px] font-medium text-brand-600 dark:text-brand-300" id="hero-verdict" aria-live="polite">
    Самозанятость экономит 2 000 ₽ в месяц
  </p>

  <a
    href="/dlya-samozanyatyh/npd-vs-ip/"
    class="mt-5 flex items-center justify-center min-h-12 px-4 rounded-md bg-brand-600 hover:bg-brand-700 dark:bg-brand-300 dark:hover:bg-brand-200 text-ink-50 dark:text-ink-950 font-medium"
  >
    Подробное сравнение НПД и ИП
  </a>
</div>

<script>
(function() {
  const slider = document.getElementById('hero-income') as HTMLInputElement | null;
  const valueEl = document.getElementById('hero-income-value');
  const npdEl = document.getElementById('hero-npd-amount');
  const usnEl = document.getElementById('hero-usn-amount');
  const npdBar = document.getElementById('hero-npd-bar');
  const usnBar = document.getElementById('hero-usn-bar');
  const verdictEl = document.getElementById('hero-verdict');

  if (!slider) return;
  const NPD_ANNUAL_LIMIT = 2_400_000;

  function calcBurden(income: number) {
    const npd = income * 0.04;
    const annual = income * 12;
    const mf = 57390 / 12;
    const m1p = Math.max(0, (annual - 300000) * 0.01) / 12;
    const contribs = mf + m1p;
    const baseTax = income * 0.06;
    const ded = Math.min(contribs, baseTax);
    const taxPayable = Math.max(0, baseTax - ded);
    const usn = taxPayable + contribs;
    return { npd, usn };
  }

  function fmt(n: number) {
    return Math.round(n).toLocaleString('ru-RU');
  }

  function update(income: number) {
    const r = calcBurden(income);
    const maxVal = Math.max(r.npd, r.usn, 1);
    const npdPct = (r.npd / maxVal) * 100;
    const usnPct = (r.usn / maxVal) * 100;

    if (npdEl) npdEl.textContent = fmt(r.npd) + ' ₽';
    if (usnEl) usnEl.textContent = fmt(r.usn) + ' ₽';
    if (npdBar) npdBar.style.width = Math.max(npdPct, 6) + '%';
    if (usnBar) usnBar.style.width = Math.max(usnPct, 6) + '%';

    // НПД доступен только до 2,4 млн ₽ в год (ст. 4 422-ФЗ).
    if (income * 12 > NPD_ANNUAL_LIMIT) {
      if (npdEl) npdEl.textContent = 'недоступно';
      if (npdBar) npdBar.style.width = '0%';
      if (verdictEl) {
        verdictEl.textContent = 'Доход выше 2,4 млн ₽ в год: самозанятость недоступна, подойдёт ИП';
        verdictEl.className = 'mt-4 text-[15px] font-medium text-warm-700 dark:text-warm-300';
      }
      return;
    }

    const diff = Math.abs(r.npd - r.usn);
    const threshold = Math.max(r.npd, r.usn) * 0.02;
    let text = '';
    if (diff <= threshold) {
      text = 'Нагрузка в обоих режимах почти одинаковая';
    } else if (r.npd < r.usn) {
      text = 'Самозанятость экономит ' + fmt(r.usn - r.npd) + ' ₽ в месяц';
    } else {
      text = 'ИП на УСН 6% выгоднее на ' + fmt(r.npd - r.usn) + ' ₽ в месяц';
    }
    if (verdictEl) {
      verdictEl.textContent = text;
      verdictEl.className = 'mt-4 text-[15px] font-medium ' + (r.npd <= r.usn ? 'text-brand-600 dark:text-brand-300' : 'text-ink-800 dark:text-ink-200');
    }
  }

  slider.addEventListener('input', function() {
    const val = parseInt((this as HTMLInputElement).value, 10);
    if (valueEl) valueEl.textContent = fmt(val) + ' ₽';
    slider.setAttribute('aria-valuetext', fmt(val) + ' рублей');
    update(val);
  });

  update(parseInt(slider.value, 10));
})();
</script>
