---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

const navLinks = [
  { label: 'Самозанятым', href: '/dlya-samozanyatyh/' },
  { label: 'Семье', href: '/semia/' },
  { label: 'ЖКХ', href: '/zhkh/' },
  { label: 'Авто', href: '/avto/' },
  { label: 'Банки и карты', href: '/banki/' },
  { label: 'Блог', href: '/blog/' },
];

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 h-16 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 transition-colors">
  <div class="container-main h-full flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="group flex items-center gap-2.5 hover:opacity-95 transition-opacity" aria-label="Считай.RU — Главная">
      <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white shadow-xs group-hover:bg-brand-500 transition-colors">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="4"></rect>
          <path d="M8 8h8"></path>
          <path d="M8 12h8"></path>
          <path d="M12 16h4"></path>
          <circle cx="8" cy="16" r=".75" fill="currentColor"></circle>
        </svg>
      </span>
      <div class="flex items-center gap-1.5">
        <span class="font-bold text-[17px] tracking-tight text-slate-900 dark:text-white">Считай.RU</span>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 font-tabular">
          2026
        </span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Основная навигация">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-[13.5px] transition-colors ${
              active
                ? 'bg-slate-100 dark:bg-slate-800/80 text-brand-600 dark:text-brand-400 font-semibold'
                : 'font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100/70 dark:hover:bg-slate-800/50'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right Controls -->
    <div class="flex items-center gap-2">
      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        type="button"
        class="md:hidden w-9 h-9 flex items-center justify-center rounded-lg text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
        aria-label="Открыть меню навигации"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <svg class="w-5 h-5 menu-icon-open" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg class="w-5 h-5 menu-icon-close hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div
    class="md:hidden overflow-hidden border-b border-slate-200/80 dark:border-slate-800/80 bg-white/95 dark:bg-slate-950/95 backdrop-blur-xl transition-all duration-200 ease-out"
    data-mobile-menu
    style="max-height: 0; opacity: 0;"
  >
    <div class="container-main py-3 space-y-1">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <a
            href={link.href}
            class={`block px-3 py-2 rounded-lg text-sm transition-colors ${
              active
                ? 'bg-slate-100 dark:bg-slate-800/80 text-brand-600 dark:text-brand-400 font-semibold'
                : 'text-slate-700 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/50 hover:text-slate-900 dark:hover:text-white font-medium'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      <div class="pt-3 mt-2 border-t border-slate-200/70 dark:border-slate-800/70 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400 px-3">
        <span>Ставки 2026 года</span>
        <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          Все системы онлайн
        </span>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggle = document.querySelector('[data-mobile-menu-toggle]');
    const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
    const iconOpen = toggle?.querySelector('.menu-icon-open');
    const iconClose = toggle?.querySelector('.menu-icon-close');

    if (toggle && menu) {
      let isOpen = false;
      const content = menu.firstElementChild as HTMLElement | null;

      toggle.addEventListener('click', () => {
        isOpen = !isOpen;
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

        if (isOpen) {
          const scrollH = content ? content.scrollHeight + 24 : 320;
          menu.style.maxHeight = scrollH + 'px';
          menu.style.opacity = '1';
          iconOpen?.classList.add('hidden');
          iconClose?.classList.remove('hidden');
        } else {
          menu.style.maxHeight = '0';
          menu.style.opacity = '0';
          iconOpen?.classList.remove('hidden');
          iconClose?.classList.add('hidden');
        }
      });
    }
  });
</script>
