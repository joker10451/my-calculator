---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
  <div class="container-main flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2 font-heading font-bold text-lg text-gray-900 dark:text-white hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
      <span class="w-8 h-8 bg-accent-600 rounded-lg flex items-center justify-center text-white text-sm font-bold">∑</span>
      Считай.RU
    </a>

    <nav class="hidden md:flex items-center gap-6" aria-label="Основная навигация">
      <a href="/dlya-samozanyatyh/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Самозанятым</a>
      <a href="/semia/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Семье</a>
      <a href="/zhkh/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">ЖКХ</a>
      <a href="/avto/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Авто</a>
      <a href="/banki/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Банки и карты</a>
      <a href="/blog/" class="text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">Блог</a>
    </nav>

    <div class="flex items-center gap-3">
      <ThemeToggle />
      <button class="md:hidden min-w-[44px] min-h-[44px] flex items-center justify-center rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Открыть меню" data-mobile-menu-toggle>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="md:hidden overflow-hidden border-t border-gray-200 dark:border-gray-800 transition-all duration-300 ease-out" data-mobile-menu style="max-height: 0; opacity: 0;">
    <div class="container-main py-2">
      <a href="/dlya-samozanyatyh/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">Самозанятым</a>
      <a href="/semia/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">Семье</a>
      <a href="/zhkh/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">ЖКХ</a>
      <a href="/avto/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">Авто</a>
      <a href="/banki/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">Банки и карты</a>
      <a href="/blog/" class="block py-3 text-sm font-medium text-gray-600 dark:text-gray-300 hover:text-accent-600 transition-colors">Блог</a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    var toggle = document.querySelector('[data-mobile-menu-toggle]');
    var menu = document.querySelector('[data-mobile-menu]');
    if (toggle && menu) {
      var content = menu.querySelector('.container-main');
      var isOpen = false;
      toggle.addEventListener('click', function() {
        isOpen = !isOpen;
        if (isOpen) {
          menu.style.maxHeight = content.scrollHeight + 40 + 'px';
          menu.style.opacity = '1';
        } else {
          menu.style.maxHeight = '0';
          menu.style.opacity = '0';
        }
      });
    }
  });
</script>
