---
import PartnerPromo from './PartnerPromo.astro';

interface Props {
  title?: string;
  subtitle?: string;
  className?: string;
}

const {
  title = 'Подготовка к ЕГЭ и ОГЭ: 4 предмета по цене одного в онлайн-школе «Сотка»',
  subtitle = 'Экономьте семейный бюджет на репетиторах: комплексная подготовка к экзаменам для 9–11 классов от 3 990 ₽/мес за все 4 предмета.',
  className = '',
} = Astro.props;
---

<PartnerPromo
  ariaLabel="Онлайн-школа «Сотка»: подготовка к ЕГЭ и ОГЭ"
  eyebrow="Образование для детей · Подготовка к экзаменам"
  title={title}
  subtitle={subtitle}
  className={className}
  partner="Сотка"
  features={[
    { tag: 'Выгода 4 в 1', title: '4 предмета по одной подписке', desc: 'Готовьтесь к русскому, математике и профильным предметам без переплат' },
    { tag: 'Поддержка 24/7', title: 'Онлайн-наставник и проверка ДЗ', desc: 'Индивидуальный разбор ошибок, регулярные пробники и контроль прогресса' },
    { tag: 'Результат 80+', title: 'Высокие баллы и бюджет', desc: 'Средний балл выпускников 80+, экономия до 200 000 ₽/год на репетиторах' },
  ]}
  primary={{
    url: 'https://trk.ppdu.ru/click/42S9SuFL?erid=2SDnjdAKSMS&dl=https%3A%2F%2Fsotkaonline.ru',
    label: 'Записаться на бесплатный вводный урок',
    offer: 'Бесплатный вводный урок',
  }}
  secondary={{
    url: 'https://trk.ppdu.ru/click/42S9SuFL?erid=2SDnjdAKSMS',
    label: 'Все программы ОГЭ/ЕГЭ',
    offer: 'Все программы ОГЭ/ЕГЭ',
  }}
  disclosure="Реклама. ООО «Сотка Онлайн», ИНН 1655447788, erid: 2SDnjdAKSMS"
/>
