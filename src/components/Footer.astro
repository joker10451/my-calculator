---
const currentYear = 2026;
---

<footer class="mt-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-white/60 dark:bg-slate-950/60 backdrop-blur-lg">
  <div class="container-main py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Column 1: Logo & Mission -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="group inline-flex items-center gap-2.5 font-heading font-black text-lg tracking-tight text-slate-900 dark:text-white">
          <span class="relative flex items-center justify-center w-8 h-8 rounded-xl bg-gradient-to-tr from-accent-600 via-brand-600 to-indigo-500 text-white shadow-md shadow-accent-600/25 group-hover:scale-105 transition-transform">
            <svg class="w-4.5 h-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16l-8 8 8 8H4"></path>
            </svg>
          </span>
          <div class="flex items-center gap-1.5">
            <span class="bg-gradient-to-r from-slate-900 via-slate-800 to-slate-700 dark:from-white dark:via-slate-100 dark:to-slate-300 bg-clip-text text-transparent">Считай.RU</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-accent-50 dark:bg-accent-950/60 text-accent-600 dark:text-accent-400 border border-accent-200/60 dark:border-accent-800/60">
              2026
            </span>
          </div>
        </a>

        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          Независимый финансовый портал: точные налоговые расчёты, сравнение банковских продуктов и жилищных тарифов по законодательству 2026 года.
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200/60 dark:border-emerald-800/50 text-xs font-medium text-emerald-700 dark:text-emerald-300">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span>🔒 100% приватность: расчёты в браузере</span>
        </div>
      </div>

      <!-- Column 2: Калькуляторы -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Калькуляторы
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/dlya-samozanyatyh/kalkulyator-naloga/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Калькулятор налога НПД
            </a>
          </li>
          <li>
            <a href="/dlya-samozanyatyh/vychet/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Вычет 10 000 ₽
            </a>
          </li>
          <li>
            <a href="/dlya-samozanyatyh/npd-vs-ip/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              НПД vs ИП (УСН)
            </a>
          </li>
          <li>
            <a href="/banki/kalkulyator-vkladov/" class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              <span>Вклады и налог 2026</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300">NEW</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Разделы -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Разделы
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/dlya-samozanyatyh/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Самозанятым
            </a>
          </li>
          <li>
            <a href="/banki/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Банки и карты
            </a>
          </li>
          <li>
            <a href="/semia/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Семья и дети
            </a>
          </li>
          <li>
            <a href="/zhkh/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              ЖКХ
            </a>
          </li>
          <li>
            <a href="/blog/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Блог
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Юридическая информация -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="font-heading text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Юридическая информация
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/partners/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Партнёрская информация
            </a>
          </li>
          <li>
            <a href="/privacy/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Политика конфиденциальности
            </a>
          </li>
          <li>
            <a href="/terms/" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Пользовательское соглашение
            </a>
          </li>
          <li>
            <a href="/terms/#disclaimer" class="text-slate-600 dark:text-slate-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
              Дисклеймер
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="space-y-1 text-center md:text-left">
        <p>© {currentYear} Считай.RU — Независимый финансовый портал</p>
        <p class="text-[11px] text-slate-500 dark:text-slate-400">
          Результаты расчётов носят информационный характер. Для принятия финансовых решений проконсультируйтесь со специалистом.
        </p>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-medium shrink-0">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-slate-700 dark:text-slate-300">Все системы в норме ✓</span>
      </div>
    </div>
  </div>
</footer>
