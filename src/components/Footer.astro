---
const columns = [
  {
    title: 'Калькуляторы',
    links: [
      { label: 'Налог самозанятого', href: '/dlya-samozanyatyh/kalkulyator-naloga/' },
      { label: 'НПД или ИП', href: '/dlya-samozanyatyh/npd-vs-ip/' },
      { label: 'Вычет 10 000 ₽', href: '/dlya-samozanyatyh/vychet/' },
      { label: 'Доход по вкладу', href: '/banki/kalkulyator-vkladov/' },
    ],
  },
  {
    title: 'Разделы',
    links: [
      { label: 'Самозанятым', href: '/dlya-samozanyatyh/' },
      { label: 'Банки и карты', href: '/banki/' },
      { label: 'Семья и дети', href: '/semia/' },
      { label: 'ЖКХ', href: '/zhkh/' },
      { label: 'Автомобилистам', href: '/avto/' },
      { label: 'Блог', href: '/blog/' },
    ],
  },
  {
    title: 'Документы',
    links: [
      { label: 'Партнёрская информация', href: '/partners/' },
      { label: 'Политика конфиденциальности', href: '/privacy/' },
      { label: 'Пользовательское соглашение', href: '/terms/' },
      { label: 'Отказ от ответственности', href: '/terms/#disclaimer' },
    ],
  },
];
---

<footer class="mt-16 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/40">
  <div class="container-main py-10 md:py-12">
    <div class="grid gap-8 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div class="space-y-3">
        <a href="/" class="inline-flex min-h-11 items-center font-semibold text-[17px] text-slate-900 dark:text-white">Считай.RU</a>
        <p class="text-sm text-slate-600 dark:text-slate-400 max-w-xs">
          Калькуляторы налогов для самозанятых и доходности вкладов. Считают прямо в браузере, без регистрации.
        </p>
      </div>
      {columns.map((col) => (
        <div>
          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100 mb-2">{col.title}</h2>
          <ul class="text-sm">
            {col.links.map((link) => (
              <li>
                <a href={link.href} class="inline-flex min-h-9 items-center text-slate-600 dark:text-slate-400 hover:text-brand-700 dark:hover:text-brand-300 hover:underline underline-offset-4">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-10 pt-6 border-t border-slate-200 dark:border-slate-800 text-xs text-slate-600 dark:text-slate-400 space-y-1">
      <p>© 2026 Считай.RU</p>
      <p>Расчёты носят ознакомительный характер и не являются финансовой офертой.</p>
    </div>
  </div>
</footer>
