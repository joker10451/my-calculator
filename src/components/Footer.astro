---
const currentYear = 2026;
---

<footer class="mt-20 border-t border-slate-200/80 dark:border-slate-800/80 bg-white dark:bg-slate-950 transition-colors">
  <div class="container-main py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-12">
      <!-- Column 1: About & Mission -->
      <div class="lg:col-span-4 space-y-4">
        <a href="/" class="group inline-flex items-center gap-2.5 hover:opacity-95 transition-opacity" aria-label="Считай.RU">
          <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-brand-600 text-white shadow-xs group-hover:bg-brand-500 transition-colors">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="4"></rect>
              <path d="M8 8h8"></path>
              <path d="M8 12h8"></path>
              <path d="M12 16h4"></path>
              <circle cx="8.5" cy="16" r=".75" fill="currentColor"></circle>
            </svg>
          </span>
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-[17px] tracking-tight text-slate-900 dark:text-white">Считай.RU</span>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded-md text-[10px] font-medium bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 border border-slate-200/80 dark:border-slate-700/80 font-tabular">
              2026
            </span>
          </div>
        </a>

        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          Независимый финансовый портал: точные налоговые расчёты, сравнение банковских продуктов и жилищных тарифов по законодательству 2026 года.
        </p>

        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-50 dark:bg-slate-900 border border-slate-200/80 dark:border-slate-800 text-xs font-medium text-slate-600 dark:text-slate-300">
          <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
          <span>🔒 100% приватность: расчёты прямо в браузере</span>
        </div>
      </div>

      <!-- Column 2: Calculators -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Калькуляторы
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/dlya-samozanyatyh/kalkulyator-naloga/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Калькулятор налога НПД
            </a>
          </li>
          <li>
            <a href="/banki/kalkulyator-vkladov/" class="inline-flex items-center gap-1.5 text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              <span>Вклады и налог 2026</span>
              <span class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-brand-50 dark:bg-brand-950/80 text-brand-700 dark:text-brand-300">2026</span>
            </a>
          </li>
          <li>
            <a href="/dlya-samozanyatyh/npd-vs-ip/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Сравнение НПД vs ИП (УСН)
            </a>
          </li>
          <li>
            <a href="/dlya-samozanyatyh/vychet/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Налоговый вычет 10 000 ₽
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 3: Sections -->
      <div class="lg:col-span-2 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Разделы
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/dlya-samozanyatyh/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Самозанятым
            </a>
          </li>
          <li>
            <a href="/banki/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Банки и карты
            </a>
          </li>
          <li>
            <a href="/semia/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Семья и дети
            </a>
          </li>
          <li>
            <a href="/zhkh/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              ЖКХ
            </a>
          </li>
          <li>
            <a href="/avto/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Автомобилистам
            </a>
          </li>
          <li>
            <a href="/blog/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Блог
            </a>
          </li>
        </ul>
      </div>

      <!-- Column 4: Legal & Compliance -->
      <div class="lg:col-span-3 space-y-3">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-slate-100">
          Правовая информация
        </h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/partners/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Партнёрская информация
            </a>
          </li>
          <li>
            <a href="/privacy/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Политика конфиденциальности
            </a>
          </li>
          <li>
            <a href="/terms/" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Пользовательское соглашение
            </a>
          </li>
          <li>
            <a href="/terms/#disclaimer" class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors">
              Отказ от ответственности
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div class="space-y-1 text-center sm:text-left">
        <p>© {currentYear} Считай.RU — Независимый финансовый сервис</p>
        <p class="text-[11px] text-slate-400 dark:text-slate-500">
          Расчёты носят исключительно ознакомительный характер и не являются финансовой офертой.
        </p>
      </div>

      <!-- Live Status Indicator -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-[11px] font-medium shrink-0">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-slate-700 dark:text-slate-300 font-tabular">Все системы онлайн ✓</span>
      </div>
    </div>
  </div>
</footer>
